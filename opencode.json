{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "bash": "ask",
    "edit": "ask",
    "external_directory": "ask",
    "chrome_*": "ask"
  },
  "mcp": {
    "chrome": {
      "type": "local",
      "command": ["npx", "--yes", "chrome-devtools-mcp@1.14.0", "--autoConnect", "--no-usage-statistics", "--no-javascript-evaluation", "--no-file-navigations"],
      "enabled": true
    }
  }
}
